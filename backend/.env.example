# ==========================================
# Variables de entorno del Workflow Engine
# Copiar como .env y rellenar los valores
# ==========================================

# MongoDB - URI de conexión (Atlas o local)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/workflow_engine_db?retryWrites=true&w=majority
PORT=8080
JWT_SECRET=reemplaza_esto_con_una_clave_base64_larga_y_segura
JWT_EXPIRATION_MS=86400000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-de-google
FRONTEND_URL=http://tu-dominio-o-ip
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
